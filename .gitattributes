# Keep source files and shell scripts portable across Windows and Linux.
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.c text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.tex text eol=lf

# Treat binary artifacts as binary if they are ever intentionally versioned.
*.mdl binary
*.png binary
*.pdf binary
*.pt binary
*.npy binary
*.npz binary
*.mat binary
*.index binary
